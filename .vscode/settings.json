{
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": true
  },
  "editor.formatOnSave": true,
  "gopls": {
    "formatting.gofumpt": true,
    "build.buildFlags": [
      "-tags=gendata"
    ]
  },
  "go.testFlags": [
    "-tags=gendata",
    "-v",
    "-count=1"
  ],
  "go.testEnvFile": "${workspaceFolder}/.env",
  "files.associations": {
    "*.gohtml": "html"
  },
  "[html]": {
    "editor.defaultFormatter": "gohugoio.gotmplfmt"
  }
}
