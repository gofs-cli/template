{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "gofs/*": [
        "./internal/server/assets/js/*"
      ]
    }
  },
  "include": [
    "internal/**/*.js"
  ]
}
