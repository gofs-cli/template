{{ define "contacts/results" }}
<p class="muted">{{ .Page.Total }} {{ if eq .Page.Total 1 }}contact{{ else }}contacts{{ end }}</p>
<table>
	<thead>
		<tr>
			<th>Name</th>
			<th>Email</th>
			<th><span class="visually-hidden">Actions</span></th>
		</tr>
	</thead>
	<tbody id="contact-rows">
		{{ template "contacts/rows" . }}
	</tbody>
</table>
<load-more target="contact-rows">{{ template "contacts/more" . }}</load-more>
{{ end }}

{{/* "contacts/page" is what <load-more> fetches: the next rows, then the new "more" link. */}}
{{ define "contacts/page" }}
{{ template "contacts/rows" . }}
{{ template "contacts/more" . }}
{{ end }}

{{ define "contacts/rows" }}
{{ range .Rows }}{{ template "contacts/row" . }}{{ end }}
{{ end }}

{{ define "contacts/more" }}
{{ if .Page.HasMore }}
	<a href="/contacts?q={{ .Query }}&page={{ .NextPage }}">Load more</a>
{{ end }}
{{ end }}

{{ define "contacts/row" }}
<tr id="contact-{{ .Contact.ID }}" {{ if not .Contact.Active }}class="inactive"{{ end }}>
	<td>{{ .Contact.Name }}</td>
	<td>{{ .Contact.Email }}</td>
	<td class="actions">
		<edit-inline><a href="/contacts/{{ .Contact.ID }}/edit">Edit</a></edit-inline>
		<row-delete confirm="confirm-delete">
			<form method="post" action="/contacts/{{ .Contact.ID }}/delete">
				<button class="danger">Delete</button>
			</form>
		</row-delete>
	</td>
</tr>
{{ end }}

{{ define "contacts/edit-row" }}
<tr id="contact-{{ .Contact.ID }}">
	<td colspan="3">
		<edit-inline>
			<form method="post" action="/contacts/{{ .Contact.ID }}">
				<input name="first_name" value="{{ .Contact.FirstName }}" aria-label="First name" required />
				<input name="last_name" value="{{ .Contact.LastName }}" aria-label="Last name" required />
				<input name="email" type="email" value="{{ .Contact.Email }}" aria-label="Email" required />
				<button class="primary">Save</button>
				<a href="/contacts/{{ .Contact.ID }}">Cancel</a>
				{{ with .Error }}<p class="error">{{ . }}</p>{{ end }}
			</form>
		</edit-inline>
	</td>
</tr>
{{ end }}
