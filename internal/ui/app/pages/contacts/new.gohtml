{{ define "contacts/new" }}
<main>
	<h1>New contact</h1>
	<form method="post" action="/contacts" class="card form-card" novalidate>
		<div class="field">
			<label for="first_name">First name</label>
			<input id="first_name" name="first_name" value="{{ .Contact.FirstName }}" required />
			{{ with .Errors.first_name }}<p class="error">{{ . }}</p>{{ end }}
		</div>
		<div class="field">
			<label for="last_name">Last name</label>
			<input id="last_name" name="last_name" value="{{ .Contact.LastName }}" required />
			{{ with .Errors.last_name }}<p class="error">{{ . }}</p>{{ end }}
		</div>
		<validate-field src="/contacts/validate" class="field">
			<label for="email">Email</label>
			<input id="email" name="email" type="email" value="{{ .Contact.Email }}" required />
			<output for="email" class="error">{{ .Errors.email }}</output>
		</validate-field>
		<div class="actions">
			<button class="primary">Add contact</button>
			<a href="/contacts">Cancel</a>
		</div>
	</form>
</main>
{{ end }}

{{ define "contacts/field-error" }}{{ .Message }}{{ end }}
