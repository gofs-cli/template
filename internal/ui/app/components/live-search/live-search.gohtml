{{/*
components/live-search: a search form whose results the server renders.

Include it with dict:

  {{ template "components/live-search" dict "Action" "/contacts" "Target" "contact-results" "Query" .Query "Placeholder" "Search by name or email" }}
  <div id="contact-results">{{ template "contacts/results" . }}</div>

Parameters
  Action       URL the form submits to with GET. The handler returns the whole
               page for a navigation and only the results fragment for the
               component (see ui.WantsFragment).
  Target       id of the element whose content is replaced by the fragment.
  Query        current search text (optional).
  Placeholder  input placeholder (optional).
  Name         query parameter name (optional, default "q").

Without JavaScript the form submits and the page reloads with the results.
With it, <live-search> submits as the user types and swaps the fragment into
the target, keeping the URL's query string in sync.
*/}}
{{ define "components/live-search" }}
<live-search target="{{ .Target }}">
	<form method="get" action="{{ .Action }}" class="toolbar" role="search">
		<label for="{{ .Target }}-search" class="visually-hidden">Search</label>
		<input
			type="search"
			id="{{ .Target }}-search"
			name="{{ or .Name "q" }}"
			value="{{ .Query }}"
			{{ with .Placeholder }}placeholder="{{ . }}"{{ end }}
			autocomplete="off"
		/>
		<button>Search</button>
	</form>
</live-search>
{{ end }}
